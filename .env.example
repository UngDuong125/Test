# Copy to backend/.env and frontend/.env.local (see SETUP.md)

# --- Shared / Backend ---
NODE_ENV=development
PORT=4000
FRONTEND_ORIGIN=http://localhost:3000

# Supabase (service role — backend only, never expose to browser)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Or direct Postgres URL for psql / migrations:
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres

# Session cookie
SESSION_COOKIE_NAME=ta_session
SESSION_TTL_HOURS=168
# Local HTTP: false (SameSite=Lax). Production HTTPS / Vercel+Render: true (SameSite=None).
COOKIE_SECURE=false

# Password / lockout
PASSWORD_MIN_LENGTH=8
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15
TEMP_PASSWORD_TTL_HOURS=72
RESET_TOKEN_TTL_HOURS=2
INVITE_TOKEN_TTL_HOURS=72

# Email (optional in local — if unset, invites/resets are logged to backend console)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=TestArchive <noreply@testarchive.local>

# Cloudinary (optional locally — without these, upload uses HTTPS placeholder URLs)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Frontend (frontend/.env.local) ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
